name: Agentic Backtest & Dashboard Sync

on:
  schedule:
    - cron: '15 */4 * * *' # Tự động chạy lại Backtest & cập nhật Dashboard mỗi 4 tiếng
  workflow_dispatch:       # Cho phép bạn bấm Run thủ công bất cứ lúc nào trên điện thoại

permissions:
  contents: write

jobs:
  update-dashboard:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'

      - name: Install dependencies
        run: pip install requests pandas numpy

      - name: Run Agentic Backtest Engine
        env:
          TWELVE_DATA_API_KEY: ${{ secrets.TWELVE_DATA_API_KEY }}
        run: python backtest_engine.py

      - name: Commit & Push Dashboard Data
        run: |
          git config --global user.name "Agentic Bot"
          git config --global user.email "bot@users.noreply.github.com"
          git add dashboard_data.json
          git diff --quiet && git diff --staged --quiet || git commit -m "Update dashboard data [skip ci]"
          git push
